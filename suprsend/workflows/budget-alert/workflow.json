{
  "$schema": "https://schema.suprsend.com/workflow/v1/schema.json",
  "slug": "budget-alert",
  "name": "Budget Alert",
  "description": "Budget exceeded on {{$brand.brand_name}}",
  "trigger_type": "api",
  "category": "budget-alert",
  "tags": [
    "workspace-activity",
    "recip:project-manager",
    "recip:project-sponsor",
    "recip:process-owner"
  ],
  "is_enabled": true,
  "conditions": [
    {
      "type": "expression_v1",
      "expression_v1": {
        "op": "AND",
        "args": [
          {
            "op": "CONTAINS",
            "value": "$recipient.subscription.role",
            "variable": "properties.role",
            "variable_ns": "$category"
          },
          {
            "op": ">",
            "value": "$category.properties.cost",
            "variable": "cost",
            "variable_ns": ""
          },
          {
            "op": "NOT_CONTAINS",
            "value": "$recipient.distinct_id",
            "variable": "properties.except",
            "variable_ns": "$category"
          }
        ]
      }
    },
    {
      "type": "expression_v1",
      "expression_v1": {
        "op": "AND",
        "args": [
          {
            "op": "CONTAINS",
            "value": "$recipient.distinct_id",
            "variable": "properties.include",
            "variable_ns": "$category"
          }
        ]
      }
    },
    {
      "type": "expression_v1",
      "expression_v1": {
        "op": "AND",
        "args": [
          {
            "op": "==",
            "value": "\"object\"",
            "variable": "$type",
            "variable_ns": "$recipient"
          }
        ]
      }
    },
    {
      "type": "expression_v1",
      "expression_v1": {
        "op": "AND",
        "args": [
          {
            "op": "CONTAINS",
            "value": "$recipient.subscription.role",
            "variable": "properties.role",
            "variable_ns": "$category"
          },
          {
            "op": ">",
            "value": "$category.properties.cost",
            "variable": "cost",
            "variable_ns": ""
          },
          {
            "op": "EMPTY",
            "value": "",
            "variable": "properties.except",
            "variable_ns": "$category"
          }
        ]
      }
    }
  ],
  "tree": {
    "nodes": [
      {
        "ref": "send",
        "name": "Send",
        "node_type": "send_multi_channel",
        "properties": {
          "template": "budget-alert"
        }
      }
    ]
  }
}
