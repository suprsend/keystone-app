{
  "$schema": "https://schema.suprsend.com/workflow/v1/schema.json",
  "slug": "tasks-upcoming",
  "name": "Tasks Coming Up",
  "description": "Due soon: {{task_name}}",
  "trigger_type": "event",
  "trigger_events": [
    "TASKS_UPCOMING"
  ],
  "category": "tasks-coming-up",
  "tags": [
    "workspace-activity",
    "recip:team-member",
    "recip:project-manager"
  ],
  "is_enabled": true,
  "conditions": [
    {
      "type": "expression_v1",
      "expression_v1": {
        "op": "AND",
        "args": [
          {
            "op": "CONTAINS",
            "value": "$recipient.subscription.role",
            "variable": "properties.role",
            "variable_ns": "$category"
          },
          {
            "op": "NOT_CONTAINS",
            "value": "$recipient.distinct_id",
            "variable": "properties.except",
            "variable_ns": "$category"
          }
        ]
      }
    },
    {
      "type": "expression_v1",
      "expression_v1": {
        "op": "AND",
        "args": [
          {
            "op": "CONTAINS",
            "value": "$recipient.distinct_id",
            "variable": "properties.include",
            "variable_ns": "$category"
          }
        ]
      }
    },
    {
      "type": "expression_v1",
      "expression_v1": {
        "op": "AND",
        "args": [
          {
            "op": "==",
            "value": "\"object\"",
            "variable": "$type",
            "variable_ns": "$recipient"
          }
        ]
      }
    },
    {
      "type": "expression_v1",
      "expression_v1": {
        "op": "AND",
        "args": [
          {
            "op": "CONTAINS",
            "value": "$recipient.subscription.role",
            "variable": "properties.role",
            "variable_ns": "$category"
          },
          {
            "op": "EMPTY",
            "value": "",
            "variable": "properties.except",
            "variable_ns": "$category"
          }
        ]
      }
    }
  ],
  "tree": {
    "nodes": [
      {
        "ref": "wait_due",
        "name": "Remind before due date",
        "node_type": "branch_waituntil",
        "properties": {},
        "branches": [
          {
            "name": "Task closed first",
            "ref": "wu_done",
            "is_default": false,
            "is_terminal": true,
            "conditions": [
              {
                "type": "future_event",
                "event_name": "TASK_CLOSED",
                "event_conditions": [
                  {
                    "type": "expression_v1",
                    "expression_v1": {
                      "op": "AND",
                      "args": [
                        {
                          "variable_ns": "$future_event",
                          "variable": "task_id",
                          "op": "==",
                          "value": "task_id"
                        }
                      ]
                    }
                  }
                ]
              }
            ],
            "nodes": []
          },
          {
            "name": "Due date approaching",
            "ref": "wu_due",
            "is_default": true,
            "conditions": [
              {
                "type": "delay",
                "delay_properties": {
                  "delay_type": "relative_to",
                  "relative_to": {
                    "pivot_expr": ".due_date",
                    "offset_type": "before",
                    "offset_value_type": "fixed",
                    "offset_value": "3d"
                  }
                }
              }
            ],
            "nodes": [
              {
                "ref": "send",
                "name": "Send",
                "node_type": "send_multi_channel",
                "properties": {
                  "template": "tasks-upcoming"
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
