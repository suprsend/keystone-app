{
  "$schema": "https://schema.suprsend.com/workflow/v1/schema.json",
  "slug": "comment-added",
  "name": "Comment Added",
  "description": "Comment Added",
  "trigger_type": "api",
  "category": "comment-added",
  "tags": [
    "workspace-activity",
    "recip:project-manager",
    "recip:team-member"
  ],
  "is_enabled": true,
  "conditions": [
    {
      "type": "expression_v1",
      "expression_v1": {
        "op": "AND",
        "args": [
          {
            "op": "CONTAINS",
            "value": "$recipient.subscription.role",
            "variable": "properties.role",
            "variable_ns": "$category"
          },
          {
            "op": "NOT_CONTAINS",
            "value": "$recipient.distinct_id",
            "variable": "properties.except",
            "variable_ns": "$category"
          }
        ]
      }
    },
    {
      "type": "expression_v1",
      "expression_v1": {
        "op": "AND",
        "args": [
          {
            "op": "CONTAINS",
            "value": "$recipient.distinct_id",
            "variable": "properties.include",
            "variable_ns": "$category"
          }
        ]
      }
    },
    {
      "type": "expression_v1",
      "expression_v1": {
        "op": "AND",
        "args": [
          {
            "op": "==",
            "value": "\"object\"",
            "variable": "$type",
            "variable_ns": "$recipient"
          }
        ]
      }
    },
    {
      "type": "expression_v1",
      "expression_v1": {
        "op": "AND",
        "args": [
          {
            "op": "CONTAINS",
            "value": "$recipient.subscription.role",
            "variable": "properties.role",
            "variable_ns": "$category"
          },
          {
            "op": "EMPTY",
            "value": "",
            "variable": "properties.except",
            "variable_ns": "$category"
          }
        ]
      }
    }
  ],
  "tree": {
    "nodes": [
      {
        "ref": "digest_1",
        "name": "Digest",
        "node_type": "digest",
        "schema_version": "1",
        "description": null,
        "properties": {
          "schedule_type": "category_digest_schedule",
          "trigger_min_count": 1,
          "retain_count": 10,
          "retain_order": "first"
        }
      },
      {
        "ref": "send",
        "name": "Send",
        "node_type": "send_multi_channel",
        "properties": {
          "template": "comment-added-batched"
        }
      }
    ]
  }
}
