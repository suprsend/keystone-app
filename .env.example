# ============================================================================
# Keystone — environment. Copy this to .env.local and fill every blank below.
# All values come from the SuprSend dashboard. .env.local is gitignored.
#
# The app shows every workspace whose Workspace Key is set here and that exists in
# your SuprSend account. Its name, logo and colour are read from SuprSend.
# ============================================================================

# Account service token — Dashboard → Account Settings → Service Tokens → Generate
SUPRSEND_SERVICE_TOKEN=

# ── Acme workspace ──  (SuprSend → switch to Acme → Developers → API Keys)
#   WORKSPACE_KEY / WORKSPACE_SECRET  → "Workspace Key and Secret" section
#   PUBLIC_KEY                        → "Public Keys" (the SS.PUBK… value)
#   SIGNING_KEY_UID                    → "Signing Keys" — the signing_key_… UID (NOT ws_signk_…)
#   SIGNING_KEY_B64                   → "Signing Keys" → Generate → the Base64
SUPRSEND_ACME_WORKSPACE_KEY=
SUPRSEND_ACME_WORKSPACE_SECRET=
NEXT_PUBLIC_SUPRSEND_ACME_PUBLIC_KEY=
SUPRSEND_ACME_SIGNING_KEY_UID=
SUPRSEND_ACME_SIGNING_KEY_B64=

# ── Globex workspace ──  (SuprSend → switch to Globex → Developers → API Keys)
SUPRSEND_GLOBEX_WORKSPACE_KEY=
SUPRSEND_GLOBEX_WORKSPACE_SECRET=
NEXT_PUBLIC_SUPRSEND_GLOBEX_PUBLIC_KEY=
SUPRSEND_GLOBEX_SIGNING_KEY_UID=
SUPRSEND_GLOBEX_SIGNING_KEY_B64=

# Demo password gate. Keystone has no login of its own, so a hosted demo must sit
# behind something. Set this on a deployment and the whole app (pages and API)
# requires this one shared password. Leave it EMPTY locally to keep the gate off.
DEMO_PASSWORD=
