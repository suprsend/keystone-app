# ============================================================================
# Keystone — environment configuration
# ============================================================================
# Copy this file to .env.local and fill in ONE value: your SuprSend account
# service token. Everything else (the per-workspace keys) is created for you and
# written into .env.local automatically when you run:
#
#     node --env-file=.env.local scripts/provision.mjs workspaces
#
# .env.local is gitignored — your secrets never get committed.
# ----------------------------------------------------------------------------

# 1) Your SuprSend ACCOUNT service token — the ONLY value you fill in by hand.
#    SuprSend dashboard → Account Settings → Service Tokens → generate → paste here.
SUPRSEND_SERVICE_TOKEN=


# ----------------------------------------------------------------------------
# AUTO-GENERATED — you normally don't touch these.
# `provision.mjs workspaces` creates each workspace and its keys, then appends the
# lines below to .env.local for you:
#
#   SUPRSEND_ACME_WORKSPACE_KEY / _SECRET        (backend login)
#   NEXT_PUBLIC_SUPRSEND_ACME_PUBLIC_KEY         (in-app inbox)
#   SUPRSEND_ACME_SIGNING_KEY_ID / _B64          (template editor)
#   …and the same set for GLOBEX.
#
# Note: the WORKSPACE_KEY/SECRET pair carries a one-line "VERIFY mapping" comment
# the script writes above it — confirm with the SuprSend team whether the backend
# SDK uses the generated API key, or needs the dashboard Workspace Key + Secret.
# ----------------------------------------------------------------------------


# ----------------------------------------------------------------------------
# Optional overrides (rarely needed — safe to leave as-is)
# ----------------------------------------------------------------------------
# Where all demo/test emails go (address form: <user>+<name>@<domain>):
# SAFE_TEST_EMAIL_USER=nikita
# SAFE_TEST_EMAIL_DOMAIN=suprsend.com
#
# SuprSend hosts (defaults are correct for production):
# SUPRSEND_MGMNT_URL=https://management-api.suprsend.com
# SUPRSEND_HOST=https://hub.suprsend.com
#
# Only needed for the "Generate" (AI draft) button on Message Templates:
# OPENAI_API_KEY=
