# ============================================================================
# Keystone — environment configuration
# ============================================================================
# Copy this file to .env.local. You fill in TWO things:
#   1. your SuprSend account service token (below), and
#   2. each workspace's Workspace Key + Secret, copied from the dashboard (step 4
#      of the README) — those are the only values no API can generate.
# Running `node --env-file=.env.local scripts/provision.mjs workspaces` creates the
# workspaces and auto-fills their public key + signing key for you.
#
# .env.local is gitignored — your secrets never get committed.
# ----------------------------------------------------------------------------

# 1) Your SuprSend ACCOUNT service token.
#    SuprSend dashboard → Account Settings → Service Tokens → generate → paste here.
SUPRSEND_SERVICE_TOKEN=


# ----------------------------------------------------------------------------
# The `workspaces` command APPENDS these per-workspace lines for you:
#
#   NEXT_PUBLIC_SUPRSEND_ACME_PUBLIC_KEY         (in-app inbox)     — auto-filled
#   SUPRSEND_ACME_SIGNING_KEY_ID / _B64          (template editor)  — auto-filled
#   SUPRSEND_ACME_WORKSPACE_KEY / _SECRET        (backend login)    — YOU paste these
#   …and the same set for GLOBEX.
#
# The Workspace Key + Secret are the backend Node SDK credentials (HMAC). No
# Management API returns them, so copy each from the dashboard:
#   SuprSend → switch workspace → Developers → API Keys → "Workspace Key and Secret".
# ----------------------------------------------------------------------------


# ----------------------------------------------------------------------------
# Optional overrides (rarely needed — safe to leave as-is)
# ----------------------------------------------------------------------------
# Where all demo/test emails go (address form: <user>+<name>@<domain>):
# SAFE_TEST_EMAIL_USER=nikita
# SAFE_TEST_EMAIL_DOMAIN=suprsend.com
#
# SuprSend hosts (defaults are correct for production):
# SUPRSEND_MGMNT_URL=https://management-api.suprsend.com
# SUPRSEND_HOST=https://hub.suprsend.com
#
# Only needed for the "Generate" (AI draft) button on Message Templates:
# OPENAI_API_KEY=
